FROM python:3.11-slim

ENV PYTHONPATH=/opt/clear-grid:/opt/clear-grid/app:/opt/clear-grid/app/api:/opt/clear-grid/app/errors
ENV PATH=/opt/clear-grid/:$PATH
ENV FLASK_APP=clear_grid_flask_shell_ctx:app

WORKDIR /opt/clear-grid

COPY ./requirements.txt /opt/clear-grid

RUN pip install --upgrade pip && pip install -r requirements.txt

COPY ./ ./
RUN chmod a+x boot.sh

EXPOSE 5000
ENTRYPOINT ["./boot.sh"]
